{
    "name": "dev1437/laravel-api-typer",
    "autoload": {
        "psr-4": {
            "Dev1437\\LaravelApiTyper\\": "src/"
        }
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-phpunit": "^2.0",
        "nikic/php-parser": "^5.6",
        "phpstan/extension-installer": "^1.4"
    },
    "config": {
        "allow-plugins": {
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "phpstan": {
            "includes": [
                "phpstan-extension.neon"
            ]
        },
        "laravel": {
            "providers": [
                "Dev1437\\LaravelApiTyper\\ApiTyperServiceProvider"
            ]
        }
    }
}
